      m_Calls: []
  m_text: "<b><size=36>BURGER PREMIUM</size></b>\r\n<size=22>Burger dengan lapisan
    daging sapi pilihan yang tebal dan juicy, dipadukan dengan keju cheddar lumer,
    sayuran segar, serta saus rahasia.\r\n\r\n<b>Bahan Utama:</b>\r\nRoti bun wijen,
    daging sapi premium (patty), keju cheddar, selada, tomat, saus gurih.\r\n\r\n<b>Kandungan
    Gizi:</b>\r\n\u2022 Kalori: 540 kkal\r\n\u2022 Protein: 32 gram\r\n\u2022 Lemak:
    28 gram</size>"
